# 1. Disable Directory Listing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 2. Forward Authorization Header to PHP (Required for Flutter Bearer Token on cPanel)
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    # 3. Block Direct HTTP Access to Internal Directories (config, includes, backups)
    RewriteRule ^(config|includes|backups_monolith)/ - [F,L]

    # 4. Block Execution of PHP/Executable Scripts Inside uploads/ Directory
    RewriteRule ^uploads/.*\.(php|php[0-9]|phtml|pl|py|cgi|sh|htaccess)$ - [F,L,NC]

    # 5. Backward-Compatible Routing for Legacy API Paths
    RewriteRule ^api_(calendar|pdf|translate|exam|courses|subscription)\.php$ api/api_$1.php [L,QSA]
    RewriteRule ^cron_sms\.php$ cron/cron_sms.php [L,QSA]
</IfModule>

# 6. Protect Sensitive Files (.sql, .log, .env, .git)
<FilesMatch "\.(sql|log|env|bak|ini|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>